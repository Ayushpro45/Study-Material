Exp1:: Recursion tree


#include <stdio.h>
#include <math.h>


int main()
{
    int a, b, k, n;
    int level = 0;


    double nodes, subproblemSize;
    double costPerNode, totalCost;
    double total = 0;


    printf("RECURSION TREE METHOD\n");


    printf("\nRecurrence form:\n");
    printf("T(n) = aT(n/b) + n^k\n");


    printf("\nEnter value of n: ");
    scanf("%d", &n);


    printf("Enter value of a (number of subproblems): ");
    scanf("%d", &a);


    printf("Enter value of b (division factor): ");
    scanf("%d", &b);


    printf("Enter value of k in f(n) = n^k: ");
    scanf("%d", &k);


    printf("\nRECURSION TREE ANALYSIS\n");


    printf("\nRecurrence: T(n) = %dT(n/%d) + n^%d\n",
           a, b, k);


    printf("\n%-8s %-15s %-20s %-20s\n",
           "Level", "Nodes", "Problem Size", "Cost at Level");


    nodes = 1;
    subproblemSize = n;


    while (subproblemSize >= 1)
    {
        costPerNode = pow(subproblemSize, k);
        totalCost = nodes * costPerNode;


        printf("%-8d %-15.0f %-20.4f %-20.4f\n",
               level, nodes, subproblemSize, totalCost);


        total += totalCost;


        nodes = nodes * a;
        subproblemSize = subproblemSize / b;
        level++;


        if (subproblemSize < 1)
            break;
    }


    printf("\nTotal cost of recursion tree = %.4f\n", total);


    printf("\nNumber of levels = %d\n", level);


    double p = log(a) / log(b);


    printf("\nRESULT\n");


    if (k < p)
    {
        printf("At each level, the cost increases.\n");
        printf("Time Complexity = Theta(n^%.4f)\n", p);
    }
    else if (fabs(k - p) < 0.000001)
    {
        printf("Cost at every level is approximately the same.\n");
        printf("Time Complexity = Theta(n^%.4f log n)\n", p);
    }
    else
    {
        printf("Cost decreases rapidly toward the leaf level.\n");
        printf("Time Complexity = Theta(n^%d)\n", k);
    }


    return 0;
}