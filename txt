Exp 11: LCS
#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
using namespace std;
 
string findLCS(const string& X, const string& Y) {
    int m = X.length();
    int n = Y.length();
 
    vector<vector<int>> dp(m + 1, vector<int>(n + 1, 0));
 
    for (int i = 1; i <= m; i++) {
        for (int j = 1; j <= n; j++) {
            if (X[i - 1] == Y[j - 1]) {
                dp[i][j] = 1 + dp[i - 1][j - 1];
            } else {
                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]);
            }
        }
    }
 
    string lcs = "";
    int i = m, j = n;
 
    while (i > 0 && j > 0) {
        if (X[i - 1] == Y[j - 1]) {
            lcs += X[i - 1];
            i--;
            j--;
        } else if (dp[i - 1][j] >= dp[i][j - 1]) {
            i--;
        } else {
            j--;
        }
    }
 
    reverse(lcs.begin(), lcs.end());
    return lcs;
}
 
int main() {
    string version1, version2;
 
    cout << "Enter first source-code version: ";
    getline(cin, version1);
 
    cout << "Enter second source-code version: ";
    getline(cin, version2);
 
    string lcs = findLCS(version1, version2);
 
    cout << "\nLongest Common Subsequence: " << lcs << endl;
    cout << "Length of LCS: " << lcs.length() << endl;
 
    return 0;
}


Exp: 10- 0/1 knapsack problem
#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;
 
int main() {
    const int capacity = 15;
    int n;
    cout << "Enter number of items: ";
    cin >> n;
 
    if (n <= 0) {
        cout << "Number of items must be positive.\n";
        return 0;
    }
 
    vector<int> weight(n), value(n);
    for (int i = 0; i < n; i++) {
        cout << "Enter weight and value for item " << i + 1 << ": ";
        cin >> weight[i] >> value[i];
        if (weight[i] <= 0 || value[i] < 0) {
            cout << "Weight must be positive and value non-negative.\n";
            return 0;
        }
    }
 
    // dp[i][w] = best value using the first i items at capacity w.
    vector<vector<int>> dp(n + 1, vector<int>(capacity + 1, 0));
    for (int i = 1; i <= n; i++) {
        for (int w = 0; w <= capacity; w++) {
            dp[i][w] = dp[i - 1][w];
            if (weight[i - 1] <= w) {
                dp[i][w] = max(dp[i][w],
                    value[i - 1] + dp[i - 1][w - weight[i - 1]]);
            }
        }
    }
 
    cout << "\nMaximum total value: " << dp[n][capacity] << "\n";
    vector<int> selected;
    int w = capacity;
    for (int i = n; i > 0; i--) {
        if (dp[i][w] != dp[i - 1][w]) {
            selected.push_back(i);
            w -= weight[i - 1];
        }
    }
    reverse(selected.begin(), selected.end());
 
    int totalWeight = 0, totalValue = 0;
    cout << "Selected items:\n";
    for (int index : selected) {
        cout << "Item " << index << " (weight = " << weight[index - 1]
             << " kg, value = " << value[index - 1] << ")\n";
        totalWeight += weight[index - 1];
        totalValue += value[index - 1];
    }
    cout << "Total weight: " << totalWeight << " kg\n";
    cout << "Maximum total value: " << totalValue << "\n";
    return 0;
}


Exp9: Job Sequencing with Deadlines
#include <iostream>
#include <vector>
#include <algorithm>
#include <string>
using namespace std;
 
struct Job {
    string id;
    int deadline;
    int profit;
};
 
int main() {
    int n;
    cout << "Enter number of jobs: ";
    cin >> n;
    if (n <= 0) {
        cout << "Number of jobs must be positive.\n";
        return 0;
    }
    vector<Job> jobs(n);
    for (int i = 0; i < n; i++) {
        cout << "Enter job ID, deadline, and profit for job "
             << i + 1 << ": ";
        cin >> jobs[i].id >> jobs[i].deadline >> jobs[i].profit;
 
        if (jobs[i].deadline < 1 || jobs[i].profit < 0) {
            cout << "Deadline must be at least 1 and profit non-negative.\n";
            return 0;
        }
    }
 
    // Schedule jobs with higher profit first.
    sort(jobs.begin(), jobs.end(), [](const Job& a, const Job& b) {
        if (a.profit == b.profit)
            return a.deadline < b.deadline;
        return a.profit > b.profit;
    });
 
    int maxDeadline = 0;
    for (const Job& job : jobs)
        maxDeadline = max(maxDeadline, job.deadline);
    maxDeadline = min(maxDeadline, n);
 
    // Each slot stores the index of a scheduled job, or -1 if empty.
    vector<int> slot(maxDeadline + 1, -1);
    vector<bool> selected(n, false);
    int totalProfit = 0;
 
    for (int i = 0; i < n; i++) {
        int lastSlot = min(jobs[i].deadline, maxDeadline);
        for (int s = lastSlot; s >= 1; s--) {
            if (slot[s] == -1) {
                slot[s] = i;
                selected[i] = true;
                totalProfit += jobs[i].profit;
                break;
            }
        }
    }
 
    cout << "\nScheduled jobs by time slot:\n";
    for (int s = 1; s <= maxDeadline; s++) {
        if (slot[s] == -1) {
            cout << "Slot " << s << ": Empty\n";
        } else {
            const Job& job = jobs[slot[s]];
            cout << "Slot " << s << ": " << job.id
                 << " (profit = " << job.profit << ")\n";
        }
    }
 
    cout << "Maximum total profit: " << totalProfit << "\n";
    cout << "Unscheduled jobs: ";
    bool foundUnscheduled = false;
    for (int i = 0; i < n; i++) {
        if (!selected[i]) {
            cout << jobs[i].id << " ";
            foundUnscheduled = true;
        }
    }
    if (!foundUnscheduled)
        cout << "None";
    cout << "\n";
    return 0;
}






Exp8:Fractional Knapsack using Greedy
#include <iostream>
#include <vector>
#include <algorithm>
#include <iomanip>
#include <string>
using namespace std;
 
struct Item {
    int id;
    double weight, profit, ratio;
};
 
void solveStrategy(vector<Item> items, int strategy,
                   const string& title, double capacity) {
    // strategy: 1 = maximum profit, 2 = maximum weight,
    //           3 = maximum profit-to-weight ratio
    if (strategy == 1) {
        sort(items.begin(), items.end(), [](const Item& a, const Item& b) {
            if (a.profit != b.profit) return a.profit > b.profit;
            return a.id < b.id;
        });
    } else if (strategy == 2) {
        sort(items.begin(), items.end(), [](const Item& a, const Item& b) {
            if (a.weight != b.weight) return a.weight > b.weight;
            return a.id < b.id;
        });
    } else {
        sort(items.begin(), items.end(), [](const Item& a, const Item& b) {
            if (a.ratio != b.ratio) return a.ratio > b.ratio;
            return a.id < b.id;
        });
    }
 
    double remaining = capacity;
    double totalProfit = 0.0;
 
    cout << "\n" << title << "\n";
    cout << "Selection order: ";
    for (size_t i = 0; i < items.size(); ++i) {
        cout << "P" << items[i].id;
        if (i + 1 < items.size()) cout << " -> ";
    }
    cout << "\nProduct selection:\n";
 
    for (const Item& item : items) {
        if (remaining <= 0.000001) break;
 
        double selectedWeight = min(item.weight, remaining);
        double fraction = selectedWeight / item.weight;
        double earnedProfit = fraction * item.profit;
 
        cout << "P" << item.id << ": selected "
             << selectedWeight << " kg out of " << item.weight
             << " kg (" << fraction * 100.0 << "%), profit = "
             << earnedProfit << "\n";
 
        totalProfit += earnedProfit;
        remaining -= selectedWeight;
    }
 
    cout << "Total profit: " << totalProfit << "\n";
    cout << "Capacity used: " << capacity - remaining << " kg\n";
    cout << "Remaining capacity: " << remaining << " kg\n";
}
 
int main() {
    const double CAPACITY = 50.0;
    int n;
 
    cout << "Enter number of products: ";
    cin >> n;
    if (n <= 0) {
        cout << "Invalid number of products.\n";
        return 0;
    }
 
    vector<Item> items(n);
    for (int i = 0; i < n; ++i) {
        items[i].id = i + 1;
        cout << "Enter weight and profit for product " << i + 1 << ": ";
        cin >> items[i].weight >> items[i].profit;
        if (items[i].weight <= 0 || items[i].profit < 0) {
            cout << "Weight must be positive and profit non-negative.\n";
            return 0;
        }
        items[i].ratio = items[i].profit / items[i].weight;
    }
 
    cout << fixed << setprecision(2);
    cout << "\nProduct Table\n";
    cout << left << setw(12) << "Product"
         << setw(15) << "Weight(kg)"
         << setw(12) << "Profit" << "P/W Ratio\n";
    for (const Item& item : items) {
        cout << left << setw(12) << (string("P") + to_string(item.id))
             << setw(15) << item.weight
             << setw(12) << item.profit << item.ratio << "\n";
    }
 
    solveStrategy(items, 1, "1. Greedy by Maximum Profit", CAPACITY);
