const int T = 3;


class Node {
public:
    vector<int> keys;
    vector<Node*> child;
    bool leaf;


    Node(bool isLeaf) : leaf(isLeaf) {}


    void traverse() {
        int i;
        for (i = 0; i < (int)keys.size(); i++) {
            if (!leaf) child[i]->traverse();
            cout << keys[i] << " ";
        }
        if (!leaf) child[i]->traverse();
    }


    bool search(int key) {
        int i = 0;
        while (i < (int)keys.size() && key > keys[i]) i++;
        if (i < (int)keys.size() && keys[i] == key) return true;
        return !leaf && child[i]->search(key);
    }


    void splitChild(int i) {
        Node *y = child[i], *z = new Node(y->leaf);
        int mid = y->keys[T - 1];
        z->keys.assign(y->keys.begin() + T, y->keys.end());
        y->keys.resize(T - 1);
        if (!y->leaf) {
            z->child.assign(y->child.begin() + T, y->child.end());
            y->child.resize(T);
        }
        child.insert(child.begin() + i + 1, z);
        keys.insert(keys.begin() + i, mid);
    }


    void insertNonFull(int key) {
        int i = (int)keys.size() - 1;
        if (leaf) {
            while (i >= 0 && keys[i] > key) i--;
            keys.insert(keys.begin() + i + 1, key);
        } else {
            while (i >= 0 && keys[i] > key) i--;
            i++;
            if ((int)child[i]->keys.size() == 2 * T - 1) {
                splitChild(i);
                if (key > keys[i]) i++;
            }
            child[i]->insertNonFull(key);
        }
    }


    int findKey(int key) {
        int i = 0;
        while (i < (int)keys.size() && keys[i] < key) i++;
        return i;
    }


    void remove(int key) {
        int idx = findKey(key);
        if (idx < (int)keys.size() && keys[idx] == key) {
            if (leaf) keys.erase(keys.begin() + idx);
            else removeInternal(idx);
        } else if (!leaf) {
            bool last = (idx == (int)keys.size());
            if ((int)child[idx]->keys.size() < T) fill(idx);
            if (last && idx > (int)keys.size()) child[idx - 1]->remove(key);
            else child[idx]->remove(key);
        }
    }


    int predecessor(int idx) {
        Node *p = child[idx];
        while (!p->leaf) p = p->child.back();
        return p->keys.back();
    }


    int successor(int idx) {
        Node *p = child[idx + 1];
        while (!p->leaf) p = p->child[0];
        return p->keys[0];
    }


    void removeInternal(int idx) {
        int key = keys[idx];
        if ((int)child[idx]->keys.size() >= T) {
            int pred = predecessor(idx);
            keys[idx] = pred;
            child[idx]->remove(pred);
        } else if ((int)child[idx + 1]->keys.size() >= T) {
            int succ = successor(idx);
            keys[idx] = succ;
            child[idx + 1]->remove(succ);
        } else {
            merge(idx);
            child[idx]->remove(key);
        }
    }


    void fill(int idx) {
        if (idx > 0 && (int)child[idx - 1]->keys.size() >= T) borrowPrev(idx);
        else if (idx < (int)keys.size() && (int)child[idx + 1]->keys.size() >= T) borrowNext(idx);
        else if (idx < (int)keys.size()) merge(idx);
        else merge(idx - 1);
    }


    void borrowPrev(int idx) {
        Node *c = child[idx], *s = child[idx - 1];
        c->keys.insert(c->keys.begin(), keys[idx - 1]);
        if (!c->leaf) {
            c->child.insert(c->child.begin(), s->child.back());
            s->child.pop_back();
        }
        keys[idx - 1] = s->keys.back();
        s->keys.pop_back();
    }


    void borrowNext(int idx) {
        Node *c = child[idx], *s = child[idx + 1];
        c->keys.push_back(keys[idx]);
        if (!c->leaf) {
            c->child.push_back(s->child.front());
            s->child.erase(s->child.begin());
        }
        keys[idx] = s->keys.front();
        s->keys.erase(s->keys.begin());
    }


    void merge(int idx) {
        Node *c = child[idx], *s = child[idx + 1];
        c->keys.push_back(keys[idx]);
        c->keys.insert(c->keys.end(), s->keys.begin(), s->keys.end());
        if (!c->leaf) c->child.insert(c->child.end(), s->child.begin(), s->child.end());
        keys.erase(keys.begin() + idx);
        child.erase(child.begin() + idx + 1);
        delete s;
    }
};


class BTree {
    Node *root = nullptr;


    void destroy(Node *p) {
        if (!p) return;
        for (Node *c : p->child) destroy(c);
        delete p;
    }


public:
    ~BTree() { destroy(root); }


    bool search(int key) { return root && root->search(key); }


    void insert(int key) {
        if (search(key)) {
            cout << "Duplicate key!\n";
            return;
        }
        if (!root) {
            root = new Node(true);
            root->keys.push_back(key);
            return;
        }
        if ((int)root->keys.size() == 2 * T - 1) {
            Node *s = new Node(false);
            s->child.push_back(root);
            s->splitChild(0);
            int i = (key > s->keys[0]) ? 1 : 0;
            s->child[i]->insertNonFull(key);
            root = s;
        } else root->insertNonFull(key);
    }


    void remove(int key) {
        if (!search(key)) {
            cout << "Key not found!\n";
            return;
        }
        root->remove(key);
        if (root->keys.empty()) {
            Node *old = root;
            root = root->leaf ? nullptr : root->child[0];
            delete old;
        }
    }


    void display() {
        if (!root) cout << "Tree is empty";
        else root->traverse();
        cout << '\n';
    }
};


int main() {
    BTree tree;
    int ch, key;
    do {
        cout << "\n1.Insert  2.Search  3.Delete  4.Display  5.Exit\nChoice: ";
        cin >> ch;
        switch (ch) {
            case 1:
                cout << "Enter key: "; cin >> key;
                tree.insert(key); break;
            case 2:
                cout << "Enter key: "; cin >> key;
                cout << (tree.search(key) ? "Key found\n" : "Key not found\n"); break;
            case 3:
                cout << "Enter key: "; cin >> key;
                tree.remove(key); break;
            case 4: tree.display(); break;
            case 5: cout << "Exiting...\n"; break;
            default: cout << "Invalid choice!\n";
        }
    } while (ch != 5);
    return 0;
}






