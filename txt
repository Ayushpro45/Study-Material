Exp7:Quick Sort
#include <iostream>
using namespace std;


int partition(int arr[], int low, int high) {
    int pivot = arr[high];  // Select last element as pivot
    int i = low - 1;


    for (int j = low; j < high; j++) {
        if (arr[j] < pivot) {
            i++;
            swap(arr[i], arr[j]);
        }
    }


    swap(arr[i + 1], arr[high]);


    return i + 1;
}


void quickSort(int arr[], int low, int high) {
    if (low < high) {
        int pi = partition(arr, low, high);


        quickSort(arr, low, pi - 1);  // Sort left side
        quickSort(arr, pi + 1, high); // Sort right side
    }
}


int main() {
    int n;


    cout << "Enter the number of elements: ";
    cin >> n;


    int arr[n];


    cout << "Enter the elements: ";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }


    quickSort(arr, 0, n - 1);


    cout << "Sorted array: ";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }


    return 0;
}


Exp6:Implementation of Merge Sort
#include <iostream>
using namespace std;


void merge(int arr[], int low, int mid, int high) {


    int i = low;
    int j = mid + 1;
    int k = 0;


    int temp[100];


    while (i <= mid && j <= high) {
        if (arr[i] < arr[j]) {
            temp[k] = arr[i];
            i++;
        }
        else {
            temp[k] = arr[j];
            j++;
        }
        k++;
    }


    while (i <= mid) {
        temp[k] = arr[i];
        i++;
        k++;
    }


    // Copy remaining elements from right subarray
    while (j <= high) {
        temp[k] = arr[j];
        j++;
        k++;
    }


    for (i = low, k = 0; i <= high; i++, k++) {
        arr[i] = temp[k];
    }
}


void mergeSort(int arr[], int low, int high) {


    if (low < high) {


        int mid = (low + high) / 2;


        mergeSort(arr, low, mid);       // Sort left half
        mergeSort(arr, mid + 1, high);  // Sort right half


        merge(arr, low, mid, high);     // Merge both halves
    }
}


int main() {


    int n;


    cout << "Enter number of elements: ";
    cin >> n;


    int arr[100];


    cout << "Enter elements: ";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }


    mergeSort(arr, 0, n - 1);


    cout << "Sorted array: ";


    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }


    return 0;
}










Exp5: Implementation of Binary Search Algorithm
#include <iostream>
#include <vector>
using namespace std;


// Function to perform Binary Search
int binarySearch(vector<int> trainNumbers, int target) {
    int low = 0;
    int high = trainNumbers.size() - 1;


    while (low <= high) {
        int mid = low + (high - low) / 2;


        // Train number found
        if (trainNumbers[mid] == target) {
            return mid;
        }


        // Search in left half
        if (target < trainNumbers[mid]) {
            high = mid - 1;
        }
        // Search in right half
        else {
            low = mid + 1;
        }
    }


    // Train number not found
    return -1;
}


int main() {
    int n, target;


    cout << "Enter number of trains: ";
    cin >> n;


    vector<int> trainNumbers(n);


    cout << "Enter train numbers in sorted order:\n";
    for (int i = 0; i < n; i++) {
        cin >> trainNumbers[i];
    }


    cout << "Enter train number to search: ";
    cin >> target;


    int result = binarySearch(trainNumbers, target);


    if (result != -1) {
        cout << "\nTrain number " << target
             << " is available.\n";
        cout << "Found at position: " << result + 1 << endl;
    } 
    else {
        cout << "\nTrain number " << target
             << " is not available.\n";
    }


    return 0;
}


Exp4:  B+ tree


#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;


const int MAX_KEYS = 4;
const int MIN_LEAF_KEYS = 2;
const int MIN_CHILDREN = 3;


class Node {
public:
    bool leaf;
    vector<int> keys;
    vector<Node*> child;
    Node* next;


    Node(bool isLeaf) {
        leaf = isLeaf;
        next = nullptr;
    }
};


class BPlusTree {
    Node* root = nullptr;


    int minKey(Node* p) {
        while (!p->leaf)
            p = p->child[0];
        return p->keys[0];
    }


    void rebuild(Node* p) {
        p->keys.clear();
        for (int i = 1; i < p->child.size(); i++)
            p->keys.push_back(minKey(p->child[i]));
    }


    // Insertion
    Node* insertRec(Node* p, int key) {
        if (p->leaf) {
            p->keys.insert(
                lower_bound(p->keys.begin(), p->keys.end(), key),
                key
            );


            if (p->keys.size() <= MAX_KEYS)
                return nullptr;


            Node* right = new Node(true);
            int mid = (p->keys.size() + 1) / 2;


            right->keys.assign(
                p->keys.begin() + mid, p->keys.end()
            );


            p->keys.resize(mid);
            right->next = p->next;
            p->next = right;


            return right;
        }


        int i = upper_bound(
            p->keys.begin(), p->keys.end(), key
        ) - p->keys.begin();


        Node* right = insertRec(p->child[i], key);


        if (right)
            p->child.insert(p->child.begin() + i + 1, right);


        rebuild(p);


        if (p->child.size() <= MAX_KEYS + 1)
            return nullptr;


        Node* newRight = new Node(false);
        int mid = p->child.size() / 2;


        newRight->child.assign(
            p->child.begin() + mid, p->child.end()
        );


        p->child.resize(mid);


        rebuild(p);
        rebuild(newRight);


        return newRight;
    }


    // Check underflow
    bool underflow(Node* p) {
        if (p->leaf)
            return p->keys.size() < MIN_LEAF_KEYS;


        return p->child.size() < MIN_CHILDREN;
    }


    bool canLend(Node* p) {
        if (p->leaf)
            return p->keys.size() > MIN_LEAF_KEYS;


        return p->child.size() > MIN_CHILDREN;
    }


    // Borrow or merge
    void rebalance(Node* parent, int i) {
        Node* cur = parent->child[i];


        if (i > 0 && canLend(parent->child[i - 1])) {
            Node* left = parent->child[i - 1];


            if (cur->leaf) {
                cur->keys.insert(
                    cur->keys.begin(), left->keys.back()
                );
                left->keys.pop_back();
            } else {
                cur->child.insert(
                    cur->child.begin(), left->child.back()
                );
                left->child.pop_back();
                rebuild(left);
                rebuild(cur);
            }
            return;
        }


        if (i + 1 < parent->child.size() &&
            canLend(parent->child[i + 1])) {
            Node* right = parent->child[i + 1];


            if (cur->leaf) {
                cur->keys.push_back(right->keys.front());
                right->keys.erase(right->keys.begin());
            } else {
                cur->child.push_back(right->child.front());
                right->child.erase(right->child.begin());
                rebuild(cur);
                rebuild(right);
            }
            return;
        }


        if (i > 0) {
            Node* left = parent->child[i - 1];


            if (cur->leaf) {
                left->keys.insert(
                    left->keys.end(),
                    cur->keys.begin(), cur->keys.end()
                );
                left->next = cur->next;
            } else {
                left->child.insert(
                    left->child.end(),
                    cur->child.begin(), cur->child.end()
                );
                rebuild(left);
            }


            delete cur;
            parent->child.erase(parent->child.begin() + i);
        } else {
            Node* right = parent->child[i + 1];


            if (cur->leaf) {
                cur->keys.insert(
                    cur->keys.end(),
                    right->keys.begin(), right->keys.end()
                );
                cur->next = right->next;
            } else {
                cur->child.insert(
                    cur->child.end(),
                    right->child.begin(), right->child.end()
                );
                rebuild(cur);
            }


            delete right;
            parent->child.erase(parent->child.begin() + i + 1);
        }
    }


    // Deletion
    void eraseRec(Node* p, int key) {
        if (p->leaf) {
            auto it = lower_bound(
                p->keys.begin(), p->keys.end(), key
            );


            if (it != p->keys.end() && *it == key)
                p->keys.erase(it);


            return;
        }


        int i = upper_bound(
            p->keys.begin(), p->keys.end(), key
        ) - p->keys.begin();


        eraseRec(p->child[i], key);


        if (underflow(p->child[i]))
            rebalance(p, i);


        rebuild(p);
    }


    // Searching
    bool searchRec(Node* p, int key) {
        if (!p)
            return false;


        if (p->leaf)
            return binary_search(
                p->keys.begin(), p->keys.end(), key
            );


        int i = upper_bound(
            p->keys.begin(), p->keys.end(), key
        ) - p->keys.begin();


        return searchRec(p->child[i], key);
    }


    void destroy(Node* p) {
        if (!p) return;


        for (Node* c : p->child)
            destroy(c);


        delete p;
    }


public:
    ~BPlusTree() {
        destroy(root);
    }


    bool search(int key) {
        return searchRec(root, key);
    }


    void insert(int key) {
        if (search(key)) {
            cout << "Duplicate key!\n";
            return;
        }


        if (!root) {
            root = new Node(true);
            root->keys.push_back(key);
            return;
        }


        Node* right = insertRec(root, key);


        if (right) {
            Node* newRoot = new Node(false);
            newRoot->child.push_back(root);
            newRoot->child.push_back(right);


            rebuild(newRoot);
            root = newRoot;
        }
    }


    void remove(int key) {
        if (!search(key)) {
            cout << "Key not found!\n";
            return;
        }


        eraseRec(root, key);


        if (root && !root->leaf &&
            root->child.size() == 1) {
            Node* old = root;
            root = root->child[0];
            delete old;
        }


        if (root && root->leaf && root->keys.empty()) {
            delete root;
            root = nullptr;
        }
    }


    // Display all leaf nodes
    void display() {
        if (!root) {
            cout << "Tree is empty\n";
            return;
        }


        Node* p = root;


        while (!p->leaf)
            p = p->child[0];


        cout << "B+ Tree elements: ";


        while (p) {
            for (int x : p->keys)
                cout << x << " ";


            p = p->next;
        }


        cout << endl;
    }
};


int main() {
    BPlusTree tree;
    int choice, key;


    do {
        cout << "\nB+ TREE OPERATIONS\n";
        cout << "1. Insert\n";
        cout << "2. Search\n";
        cout << "3. Delete\n";
        cout << "4. Display\n";
        cout << "5. Exit\n";


        cout << "Enter choice: ";
        cin >> choice;


        switch (choice) {
            case 1:
                cout << "Enter key: ";
                cin >> key;
                tree.insert(key);
                break;


            case 2:
                cout << "Enter key: ";
                cin >> key;


                if (tree.search(key))
                    cout << "Key found\n";
                else
                    cout << "Key not found\n";
                break;


            case 3:
                cout << "Enter key: ";
                cin >> key;
                tree.remove(key);
                break;


            case 4:
                tree.display();
                break;


            case 5:
                cout << "Exiting...\n";
                break;


            default:
                cout << "Invalid choice!\n";
        }


    } while (choice != 5);


    return 0;
}








